{
  "name": "mini-games",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8765",
    "build": "vite build",
    "preview": "vite preview --port 8765",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "lint": "prettier --check . && node tools/check_style.js && for g in games/*/; do node tools/check_i18n.js \"$g\" || exit 1; done",
    "test:engine": "vitest run --project engine",
    "format": "prettier --write ."
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/three": "~0.128.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
