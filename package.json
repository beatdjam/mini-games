{
  "name": "mini-games",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8765",
    "build": "vite build",
    "preview": "vite preview --port 8765",
    "typecheck": "tsc --noEmit",
    "test": "tools/test.sh",
    "test:build": "tools/test.sh --build",
    "lint": "node tools/check_style.js && for g in games/*/; do node tools/check_i18n.js \"$g\" || exit 1; done"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/three": "~0.128.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
