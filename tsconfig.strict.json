{
  // Files already written to the strict rules. npm run typecheck checks the whole repo with the loose settings
  // (tsconfig.json), then these files strictly. To tighten a file: add it here, run `npx tsc -p tsconfig.strict.json`,
  // and fix what it reports. The check also covers every file a listed file imports, so go from the leaves up
  // (a file can join once everything it imports is already listed).
  "extends": "./tsconfig.json",
  "compilerOptions": { "strict": true },
  "include": ["engine/**/*.ts"],
  // game files already strict are listed here until the whole game is
  "files": [
    "games/sector-dive/js/data/biomes.ts",
    "games/sector-dive/js/data/bosses.ts",
    "games/sector-dive/js/data/controls.ts",
    "games/sector-dive/js/data/enemies.ts",
    "games/sector-dive/js/data/level.ts",
    "games/sector-dive/js/data/music.ts",
    "games/sector-dive/js/data/perks.ts",
    "games/sector-dive/js/data/progress.ts",
    "games/sector-dive/js/data/sfx.ts",
    "games/sector-dive/js/data/types.ts",
    "games/sector-dive/js/data/viewmodels.ts",
    "games/sector-dive/js/data/weapons.ts",
    "games/sector-dive/js/lang/en.ts",
    "games/sector-dive/js/lang/ja.ts"
  ]
}
