{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "instructions": [".opencode/rules.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git switch*": "deny",
      "git checkout*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "gh *": "deny",
      "npm install*": "ask",
      "npm i *": "ask",
      "rm -rf*": "ask"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "watcher": {
    "ignore": ["dist/**", "dist-test/**", "out/**", "sim-results/**", ".tmp-shots/**"]
  }
}
